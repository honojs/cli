{
  "name": "@hono/cli",
  "version": "1.0.0-rc.7",
  "type": "module",
  "bin": {
    "hono": "dist/cli.js"
  },
  "scripts": {
    "build": "vp pack",
    "watch": "vp pack --watch",
    "test": "vp test",
    "test:run": "vp test --run",
    "test:watch": "vp test --watch",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint src",
    "lint:fix": "vp lint --fix src",
    "format": "vp fmt --check src",
    "format:fix": "vp fmt src",
    "postbuild": "publint",
    "prerelease": "pnpm run build",
    "release": "np --no-publish"
  },
  "files": [
    "dist"
  ],
  "author": "Yusuke Wada <yusuke@kamawada.com> (https://github.com/yusukebe)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honojs/cli.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://hono.dev",
  "dependencies": {
    "@bluwy/giget-core": "^0.1.7",
    "@inquirer/select": "^5.2.6",
    "commander": "^14.0.1",
    "esbuild": "^0.25.10",
    "hono": "^4.9.12 || ^5.0.0-0"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@types/node": "^24.7.0",
    "magic-string": "^0.30.21",
    "np": "^10.2.0",
    "pkg-pr-new": "^0.0.62",
    "publint": "^0.3.14",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
